```gitignore
# Compiled and binary files
*.pyc
__pycache__/
*.o
*.obj
*.so
*.dll
*.exe

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors/IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage
.coverage
coverage/
htmlcov/

# System files
.DS_Store
Thumbs.db

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/
```